# Role fragment appended to base.yaml.tftpl - no `#cloud-config` header, and no
# top-level key that base.yaml.tftpl already emits.
#
# A role makes packages installable and drops config in place; *which* packages
# get installed stays in the inventory file's `packages:` list, so there is one
# source of truth. For this role the inventory file MUST carry:
#
#   packages: [docker-ce, docker-ce-cli, containerd.io, docker-compose-plugin]
#
# Forgetting it is silent at plan time: the usermod runcmd below then fails at
# first boot ("group 'docker' does not exist") and the apply still succeeds.
#
# Note: download.docker.com has no snapshot service, so `archive_snapshot:`
# does not pin these packages. For full repeatability pin exact versions in
# the inventory list, e.g. docker-ce=5:28.0.1-1~ubuntu.26.04~resolute.
#
# Adding the login user to the docker group happens in docker.runcmd.json.tftpl
# next to this file: the group does not exist until docker-ce installs, which
# is after cloud-init creates the user, so it has to be a runcmd.

apt:
  sources:
    docker:
      source: "deb [arch=amd64 signed-by=$KEY_FILE] https://download.docker.com/linux/ubuntu $RELEASE stable"
      keyid: 9DC858229FC7DD38854AE2D88D81803C0EBFCD88

write_files:
  - path: /etc/docker/daemon.json
    permissions: "0644"
    content: |
      {
        "log-driver": "json-file",
        "log-opts": { "max-size": "10m", "max-file": "3" }
      }
